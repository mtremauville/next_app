<div class="nerv-password-rules" id="password-rules">
  <p class="nerv-hint"><%= t("account.password_rules_title") %></p>
  <ul>
    <li><%= t("account.password_rule.length") %></li>
    <% User::PASSWORD_RULES.each do |rule| %>
      <li><%= t("account.password_rule.#{rule}") %></li>
    <% end %>
  </ul>
</div>
