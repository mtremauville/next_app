<section class="nerv-auth nerv-auth--single">
  <div class="nerv-panel nerv-auth-form">
    <h2><%= t("account.edit_title") %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autocomplete: "email" %>

      <%= f.label :password do %>
        <%= t("account.new_password") %> <span class="nerv-hint"><%= t("account.keep_password") %></span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", aria: { describedby: "password-rules" } %>
      <%= render "shared/password_rules" %>

      <%= f.label :password_confirmation, t("account.password_confirmation") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>

      <%= f.label :current_password do %>
        <%= t("account.current_password") %> <span class="nerv-hint"><%= t("account.current_password_hint") %></span>
      <% end %>
      <%= f.password_field :current_password, autocomplete: "current-password" %>

      <div class="nerv-actions">
        <%= f.submit "[ #{t("account.update")} ]" %>
        <%= link_to "[ #{t("account.back")} ]", root_path %>
      </div>
    <% end %>

    <h2 class="nerv-section"><%= t("account.cancel_title") %></h2>
    <p><%= t("account.cancel_text") %></p>
    <%= render "shared/confirm_delete",
          title: t("account.cancel_confirm_title"),
          message: t("account.cancel_confirm"),
          path: registration_path(:user),
          trigger: t("account.cancel_button"),
          confirm: t("account.cancel_button"),
          trigger_class: "nerv-danger" %>
  </div>
</section>
