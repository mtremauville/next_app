<h1><%= t("catalog.title") %></h1>

<nav class="nerv-tabs" aria-label="<%= t("catalog.types_label") %>">
  <%= link_to "[ #{t("catalog.movies")} ]", catalog_path(type: "movie", q: @query.presence), class: ("is-active" if @media_type == "movie") %>
  <%= link_to "[ #{t("catalog.series")} ]", catalog_path(type: "tv", q: @query.presence), class: ("is-active" if @media_type == "tv") %>
</nav>

<%= form_with url: catalog_path, method: :get, class: "nerv-search" do %>
  <%= hidden_field_tag :type, @media_type %>
  <%= search_field_tag :q, @query, placeholder: t("catalog.search_placeholder"), "aria-label": t("catalog.search_label") %>
  <%= submit_tag "[ #{t("catalog.search")} ]", name: nil %>
<% end %>

<% if @unavailable %>
  <p class="nerv-flash nerv-flash--alert"><%= t("catalog.unavailable") %></p>
<% elsif @result.items.empty? %>
  <p><%= t("catalog.no_results", query: @query) %></p>
<% else %>
  <h2><%= @query.length >= 2 ? t("catalog.results") : t("catalog.popular") %></h2>

  <div data-controller="add-to-playlist">
    <div class="nerv-gallery">
      <%= render partial: "catalog/item", collection: @result.items, as: :item %>
    </div>

    <%= render "catalog/playlist_modal", playlists: @playlists %>
  </div>

  <nav class="nerv-pagination" aria-label="<%= t("catalog.pagination") %>">
    <% if @result.page > 1 %>
      <%= link_to "[ #{t("catalog.previous")} ]", catalog_path(type: @media_type, q: @query.presence, page: @result.page - 1) %>
    <% end %>
    <span><%= t("catalog.page", page: @result.page, total: @result.total_pages) %></span>
    <% if @result.page < @result.total_pages %>
      <%= link_to "[ #{t("catalog.next")} ]", catalog_path(type: @media_type, q: @query.presence, page: @result.page + 1) %>
    <% end %>
  </nav>
<% end %>
