<h1>Playlists</h1>

<p><%= link_to "[ Nouvelle playlist ]", new_playlist_path %></p>

<% if @playlists.empty? %>
  <p>Aucune playlist pour l'instant. Crée-en une pour organiser tes titres.</p>
<% else %>
  <div class="nerv-grid">
    <% @playlists.each do |playlist| %>
      <article class="nerv-panel">
        <h2><%= playlist.name %></h2>
        <p><%= pluralize(playlist.entries.size, "titre") %></p>
        <% if playlist.entries.any? %>
          <ul>
            <% playlist.entries.each do |entry| %>
              <li class="status-<%= entry.status %>">
                <span class="nerv-led"></span><%= entry.title %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <div class="nerv-actions">
          <%= link_to "[ Renommer ]", edit_playlist_path(playlist) %>
          <%= button_to "[ Supprimer ]", playlist_path(playlist), method: :delete,
                class: "nerv-link-button",
                form: { data: { turbo_confirm: "Supprimer cette playlist ? Les titres seront conservés." } } %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
